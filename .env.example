# Copy to .env and fill in. Never commit .env.

# Anthropic API key from https://platform.claude.com
DOCASSIST_ANTHROPIC_API_KEY=
# Set explicitly so a globally exported ANTHROPIC_BASE_URL (e.g. a local proxy) is never picked up
DOCASSIST_ANTHROPIC_BASE_URL=https://api.anthropic.com
DOCASSIST_MODEL=claude-opus-5-5

# PostgreSQL (docker compose service "db")
POSTGRES_USER=docassist
POSTGRES_PASSWORD=docassist
POSTGRES_DB=docassist
DOCASSIST_DATABASE_URL=postgresql+asyncpg://docassist:docassist@localhost:5432/docassist
